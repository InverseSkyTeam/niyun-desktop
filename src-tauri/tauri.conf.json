{
    "$schema": "https://schema.tauri.app/config/2",
    "productName": "niyun-desktop",
    "version": "0.1.0",
    "identifier": "com.niyun.desktop",
    "build": {
        "beforeDevCommand": "pnpm run dev",
        "devUrl": "http://localhost:1420",
        "beforeBuildCommand": "pnpm run build",
        "frontendDist": "../dist"
    },
    "app": {
        "windows": [
            {
                "label": "main",
                "title": "逆云",
                "width": 960,
                "height": 680,
                "minWidth": 560,
                "minHeight": 460,
                "decorations": false,
                "resizable": true,
                "transparent": false
            }
        ],
        "security": {
            "csp": "default-src 'self' ipc: http://ipc.localhost; script-src 'self' 'unsafe-inline'; style-src 'self' 'unsafe-inline'; img-src 'self' data: https: asset:; font-src 'self' data:; connect-src ipc: http://ipc.localhost https: ws: wss:"
        }
    },
    "bundle": {
        "active": true,
        "targets": "all",
        "icon": [
            "icons/32x32.png",
            "icons/128x128.png",
            "icons/128x128@2x.png",
            "icons/icon.icns",
            "icons/icon.ico"
        ]
    }
}
